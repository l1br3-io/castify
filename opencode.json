{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--executable-path",
          "/home/jpt/.local/bin/google-chrome"
        ]
      },
      "cloudflare-docs": {
        "type": "local",
        "command": ["npx", "mcp-remote", "https://docs.mcp.cloudflare.com/mcp"]
      },
      "cloudflare-builds": {
        "type": "local",
        "command": ["npx", "mcp-remote@latest", "https://builds.mcp.cloudflare.com/mcp"]
      },
      "cloudflare-logs": {
        "type": "local",
        "command": ["npx", "mcp-remote", "https://observability.mcp.cloudflare.com/mcp"]
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      }
    }
  }
}
