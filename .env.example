# Castify local environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Full reference: docs/config.md

# --- Runtime ---
CASTIFY_HOST=0.0.0.0
CASTIFY_PORT=8427
CASTIFY_LOG=info
CASTIFY_DATA_DIR=./data
# CASTIFY_DB_PATH=<DATA_DIR>/castify.db

# --- Secrets (auto-generated on first boot; uncomment to share across instances) ---
# CASTIFY_SESSION_SECRET=
# CASTIFY_TOKEN_KEY=

# --- App URL & cookies ---
# Required when connecting a cloud provider (used for OAuth redirect URIs).
CASTIFY_APP_BASE_URL=http://localhost:8427
# CASTIFY_COOKIE_SECURE=    # auto: true when APP_BASE_URL is https

# --- Providers (OAuth creds; leave empty to hide a provider) ---
CASTIFY_GOOGLE_CLIENT_ID=
CASTIFY_GOOGLE_CLIENT_SECRET=
CASTIFY_DROPBOX_CLIENT_ID=
CASTIFY_DROPBOX_CLIENT_SECRET=
CASTIFY_MS_CLIENT_ID=
CASTIFY_MS_CLIENT_SECRET=

# --- Media server features (M4–M8) ---
# These become available as milestones M4–M8 land. See
# docs/ROADMAP-self-hosted-media-server.md for the arc.

# M4 — Hot video disk cache (AVAILABLE)
# When enabled, played videos are stream-through cached to local disk for
# disk-fast re-watching. Off by default — opt in by setting ENABLED=true.
CASTIFY_VIDEO_CACHE_ENABLED=false
# CASTIFY_VIDEO_CACHE_MAX_BYTES=10737418240
# CASTIFY_VIDEO_CACHE_DIR=<DATA_DIR>/video-cache

# M5 — Codec probing via ffprobe (AVAILABLE — requires system ffprobe,
# which the stock Docker image does not include; see docs/deploy.md
# § Transcoding & ffmpeg)
# When enabled, scan completion triggers background codec probing of all
# un-probed videos. Lazy probing on first play always runs.
# CASTIFY_PROBE_ON_SCAN=true
# CASTIFY_PROBE_CONCURRENCY=2

# M6 — Server-side transcoding (AVAILABLE — requires system ffmpeg)
# When enabled, videos with browser-incompatible codecs (e.g. HEVC, WMV,
# MPEG-2) are transcoded to H.264/AAC HLS on the fly. Requires ffmpeg
# installed at runtime.
CASTIFY_TRANSCODE_ENABLED=true
# CASTIFY_TRANSCODE_SEGMENT_DURATION_SECS=10
# CASTIFY_TRANSCODE_DIR=<DATA_DIR>/transcode-cache
# CASTIFY_TRANSCODE_CACHE_MAX_BYTES=53687091200
# M7 — Background LRU sweep interval for the transcode cache (seconds).
# Every interval, the sweep walks completed entries oldest-first and
# deletes them (row + on-disk segments) until total bytes drop below
# CASTIFY_TRANSCODE_CACHE_MAX_BYTES.
# CASTIFY_TRANSCODE_SWEEP_INTERVAL_SECS=600

# M7 — Adaptive bitrate ladder
# Comma-separated rung names from the built-in table (360p, 480p, 720p,
# 1080p). The ladder defines which HLS variants the master playlist
# advertises and which rungs hls.js can switch between.
# CASTIFY_ABR_LADDER=360p,480p,720p,1080p
# The rung to pre-compute at transcode start. Must be in the ladder.
# CASTIFY_ABR_PRECOMPUTE_CAP=720p

# --- R2 media upload (rclone recipes: `just upload-setup` etc.; docs/deploy-do-r2.md) ---
# Dedicated Object Read & Write token scoped to ONE bucket, used only for
# uploads from this machine. Castify itself gets its own token via the UI.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=castify
# R2_MOUNT=<HOME>/R2-castify
